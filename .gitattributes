* text=auto eol=lf
*.pdf binary

# These source/evaluation files carry byte hashes. Preserve their frozen bytes
# across Windows commits and checkouts rather than normalizing line endings.
data/catalog.p2*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
data/name-aliases.v1.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
data/queries.v1.*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
data/evaluation/p2-v1/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
data/queries.v2.*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
data/evaluation/p2-v2/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
